# TRUSTGRID Environment Configuration
# Smart India Hackathon 2026 - Problem Statement 26194

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Default: SQLite zero-dependency local database (auto-created as trustgrid.db)
DATABASE_FILE=trustgrid.db

# Production PostgreSQL (uncomment for PostgreSQL container / cluster)
# DATABASE_URL=postgresql://trustgrid_user:trustgrid_secure_password_2026@localhost:5432/trustgrid_db

# Cryptographic & Keystore Secrets
TRUSTGRID_WALLET_SECRET=trustgrid-master-secure-demo-secret-2026
NOTARY_DID=did:trustgrid:sys:consortium-notary

# Blockchain Substrate Mode
# Options: CONSORTIUM_LEDGER (local/dev) | HYPERLEDGER_FABRIC (production)
BLOCKCHAIN_MODE=CONSORTIUM_LEDGER

# Hyperledger Fabric Configuration (when BLOCKCHAIN_MODE=HYPERLEDGER_FABRIC)
FABRIC_PEER_ENDPOINT=grpc://fabric-peer0.trustgrid.org:7051
FABRIC_CHANNEL=trustgrid-channel
FABRIC_CHAINCODE=top-cc
FABRIC_MSPID=TrustGridOrgMSP
